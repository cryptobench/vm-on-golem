{
  "components": {
    "schemas": {
      "AdvertisementCreate": {
        "description": "Model for creating/updating an advertisement.",
        "properties": {
          "country": {
            "description": "ISO 3166-1 alpha-2 country code",
            "maxLength": 2,
            "minLength": 2,
            "title": "Country",
            "type": "string"
          },
          "endpoint_host": {
            "description": "Provider public endpoint host",
            "title": "Endpoint Host",
            "type": "string"
          },
          "endpoint_port": {
            "description": "Provider public endpoint port",
            "maximum": 65535.0,
            "minimum": 1.0,
            "title": "Endpoint Port",
            "type": "integer"
          },
          "endpoint_protocol": {
            "description": "Provider public endpoint protocol",
            "title": "Endpoint Protocol",
            "type": "string"
          },
          "endpoint_url": {
            "description": "Provider public endpoint URL",
            "title": "Endpoint Url",
            "type": "string"
          },
          "ip_address": {
            "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}$",
            "title": "Ip Address",
            "type": "string"
          },
          "platform": {
            "description": "Provider platform/architecture (e.g., x86_64, arm64)",
            "title": "Platform",
            "type": "string"
          },
          "pricing": {
            "description": "Pricing info (USD and GLM per-unit monthly)",
            "title": "Pricing",
            "type": "object"
          },
          "resources": {
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Available resources (cpu, memory, storage)",
            "title": "Resources",
            "type": "object"
          }
        },
        "required": [
          "ip_address",
          "country",
          "resources"
        ],
        "title": "AdvertisementCreate",
        "type": "object"
      },
      "AdvertisementResponse": {
        "description": "Model for advertisement responses.",
        "properties": {
          "country": {
            "title": "Country",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "endpoint_host": {
            "title": "Endpoint Host",
            "type": "string"
          },
          "endpoint_port": {
            "title": "Endpoint Port",
            "type": "integer"
          },
          "endpoint_protocol": {
            "title": "Endpoint Protocol",
            "type": "string"
          },
          "endpoint_url": {
            "title": "Endpoint Url",
            "type": "string"
          },
          "ip_address": {
            "title": "Ip Address",
            "type": "string"
          },
          "platform": {
            "title": "Platform",
            "type": "string"
          },
          "pricing": {
            "title": "Pricing",
            "type": "object"
          },
          "provider_id": {
            "title": "Provider Id",
            "type": "string"
          },
          "resources": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Resources",
            "type": "object"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "provider_id",
          "ip_address",
          "country",
          "resources",
          "created_at",
          "updated_at"
        ],
        "title": "AdvertisementResponse",
        "type": "object"
      },
      "DeleteAdvertisementResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "DeleteAdvertisementResponse",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Model for error responses.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "type": "string"
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "VM on Golem Central Discovery Service",
    "version": "0.1.0"
  },
  "openapi": "3.0.2",
  "paths": {
    "/api/v1/advertisements": {
      "get": {
        "description": "List all active advertisements matching the criteria.",
        "operationId": "list_advertisements_api_v1_advertisements_get",
        "parameters": [
          {
            "in": "query",
            "name": "cpu",
            "required": false,
            "schema": {
              "title": "Cpu",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "memory",
            "required": false,
            "schema": {
              "title": "Memory",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "storage",
            "required": false,
            "schema": {
              "title": "Storage",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "country",
            "required": false,
            "schema": {
              "title": "Country",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "platform",
            "required": false,
            "schema": {
              "title": "Platform",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AdvertisementResponse"
                  },
                  "title": "Response List Advertisements Api V1 Advertisements Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Advertisements"
      },
      "post": {
        "description": "Create or update a provider advertisement.",
        "operationId": "create_advertisement_api_v1_advertisements_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-provider-id",
            "required": true,
            "schema": {
              "title": "X-Provider-Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-provider-signature",
            "required": true,
            "schema": {
              "title": "X-Provider-Signature",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdvertisementCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdvertisementResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Advertisement"
      }
    },
    "/api/v1/advertisements/{provider_id}": {
      "delete": {
        "description": "Delete an advertisement.",
        "operationId": "delete_advertisement_api_v1_advertisements__provider_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "provider_id",
            "required": true,
            "schema": {
              "title": "Provider Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-provider-id",
            "required": true,
            "schema": {
              "title": "X-Provider-Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-provider-signature",
            "required": true,
            "schema": {
              "title": "X-Provider-Signature",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteAdvertisementResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Advertisement"
      },
      "get": {
        "description": "Get a specific advertisement by provider ID.",
        "operationId": "get_advertisement_api_v1_advertisements__provider_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "provider_id",
            "required": true,
            "schema": {
              "title": "Provider Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdvertisementResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Advertisement"
      }
    },
    "/health": {
      "get": {
        "description": "Health check endpoint.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check"
      }
    }
  }
}
