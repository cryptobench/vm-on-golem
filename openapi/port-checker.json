{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "PortCheckRequest": {
        "properties": {
          "ports": {
            "description": "List of ports to check",
            "items": {
              "type": "integer"
            },
            "title": "Ports",
            "type": "array"
          },
          "provider_ip": {
            "description": "Provider's public IP address",
            "title": "Provider Ip",
            "type": "string"
          }
        },
        "required": [
          "provider_ip",
          "ports"
        ],
        "title": "PortCheckRequest",
        "type": "object"
      },
      "PortCheckResponse": {
        "properties": {
          "message": {
            "description": "Summary message",
            "title": "Message",
            "type": "string"
          },
          "results": {
            "additionalProperties": {
              "$ref": "#/components/schemas/PortStatus"
            },
            "description": "Results for each port",
            "title": "Results",
            "type": "object"
          },
          "success": {
            "description": "Overall success status",
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "results",
          "message"
        ],
        "title": "PortCheckResponse",
        "type": "object"
      },
      "PortStatus": {
        "properties": {
          "accessible": {
            "description": "Whether the port is accessible",
            "title": "Accessible",
            "type": "boolean"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Error message if port is not accessible",
            "title": "Error"
          }
        },
        "required": [
          "accessible"
        ],
        "title": "PortStatus",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Golem Port Checker",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/check-ports": {
      "post": {
        "operationId": "check_ports_check_ports_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PortCheckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortCheckResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Check Ports"
      }
    },
