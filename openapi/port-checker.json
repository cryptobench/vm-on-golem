{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "PortCheckRequest": {
        "properties": {
          "ports": {
            "description": "List of ports to check",
            "items": {
              "type": "integer"
            },
            "title": "Ports",
            "type": "array"
          },
          "provider_ip": {
            "description": "Provider's public IP address",
            "title": "Provider Ip",
            "type": "string"
          }
        },
        "required": [
          "provider_ip",
          "ports"
        ],
        "title": "PortCheckRequest",
        "type": "object"
      },
      "PortCheckResponse": {
        "properties": {
          "message": {
            "description": "Summary message",
            "title": "Message",
            "type": "string"
          },
          "results": {
            "additionalProperties": {
              "$ref": "#/components/schemas/PortStatus"
            },
            "description": "Results for each port",
            "title": "Results",
            "type": "object"
          },
          "success": {
            "description": "Overall success status",
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "results",
          "message"
        ],
        "title": "PortCheckResponse",
        "type": "object"
      },
      "PortStatus": {
        "properties": {
          "accessible": {
            "description": "Whether the port is accessible",
            "title": "Accessible",
            "type": "boolean"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Error message if port is not accessible",
            "title": "Error"
          }
        },
        "required": [
          "accessible"
        ],
        "title": "PortStatus",
        "type": "object"
      },
      "TlsCheckRequest": {
        "properties": {
          "expected_ip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "IP address expected in the certificate SAN",
            "title": "Expected Ip"
          },
          "host": {
            "description": "Provider host or IP to check",
            "title": "Host",
            "type": "string"
          },
          "port": {
            "description": "TLS port to check",
            "maximum": 65535.0,
            "minimum": 1.0,
            "title": "Port",
            "type": "integer"
          }
        },
        "required": [
          "host",
          "port"
        ],
        "title": "TlsCheckRequest",
        "type": "object"
      },
      "TlsCheckResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "not_after": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Not After"
          },
          "peer": {
            "title": "Peer",
            "type": "string"
          },
          "valid": {
            "title": "Valid",
            "type": "boolean"
          }
        },
        "required": [
          "valid",
          "peer"
        ],
        "title": "TlsCheckResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Golem Port Checker",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/check-ports": {
      "post": {
        "operationId": "check_ports_check_ports_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PortCheckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortCheckResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Check Ports"
      }
    },
    "/check-tls": {
      "post": {
        "operationId": "check_tls_check_tls_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TlsCheckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TlsCheckResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Check Tls"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check"
      }
    }
  }
}
