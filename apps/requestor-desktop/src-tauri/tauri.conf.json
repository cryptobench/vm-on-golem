{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Golem Requestor",
  "version": "0.1.0",
  "identifier": "network.golem.requestor",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Golem Requestor",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/golem-port-checker"]
  }
}
