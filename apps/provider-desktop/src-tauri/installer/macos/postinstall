#!/bin/sh
set -eu

MULTIPASS_DIR="/Library/Application Support/Golem Provider/multipass"
MIN_VERSION="1.13.0"
VERIFY_ATTEMPTS=30
VERIFY_SLEEP_SECONDS=2

version_core() {
  printf "%s" "$1" | sed 's/[+-].*$//'
}

version_lt() {
  awk -v a="$(version_core "$1")" -v b="$(version_core "$2")" 'BEGIN {
    split(a, av, "."); split(b, bv, ".");
    for (i = 1; i <= 3; i++) {
      ai = av[i] + 0; bi = bv[i] + 0;
      if (ai < bi) exit 0;
      if (ai > bi) exit 1;
    }
    exit 1;
  }'
}

multipass_path() {
  for candidate in /opt/homebrew/bin/multipass /usr/local/bin/multipass /opt/local/bin/multipass; do
    if [ -x "$candidate" ]; then
      printf "%s" "$candidate"
      return 0
    fi
  done
  if command -v multipass >/dev/null 2>&1; then
    command -v multipass
    return 0
  fi
  return 1
}

multipass_version() {
  "$1" version 2>&1 | sed -n 's/.*multipass[[:space:]][[:space:]]*\([0-9][^[:space:]]*\).*/\1/p' | head -n 1
}

multipass_supported() {
  mp="$(multipass_path)" || return 1
  version="$(multipass_version "$mp")"
  [ -n "$version" ] || return 1
  ! version_lt "$version" "$MIN_VERSION"
}

verify_multipass() {
  multipass_supported || return 1
  mp="$(multipass_path)" || return 1
  "$mp" list --format json >/dev/null 2>&1
}

wait_for_multipass() {
  attempt=1
  while [ "$attempt" -le "$VERIFY_ATTEMPTS" ]; do
    if verify_multipass; then
      return 0
    fi

    if [ "$attempt" -lt "$VERIFY_ATTEMPTS" ]; then
      echo "Waiting for Multipass daemon to respond ($attempt/$VERIFY_ATTEMPTS)"
      sleep "$VERIFY_SLEEP_SECONDS"
    fi
    attempt=$((attempt + 1))
  done
  return 1
}

if multipass_supported && wait_for_multipass; then
  echo "Compatible Multipass already installed"
  exit 0
fi

pkg="$(find "$MULTIPASS_DIR" -maxdepth 1 -name 'multipass-*.pkg' -print | head -n 1)"
if [ -z "$pkg" ] || [ ! -f "$pkg" ]; then
  echo "Bundled Multipass pkg is missing from $MULTIPASS_DIR" >&2
  exit 1
fi

/usr/sbin/installer -pkg "$pkg" -target /

if ! wait_for_multipass; then
  echo "Multipass installed but verification failed" >&2
  exit 1
fi

echo "Multipass installed and verified"
