#!/bin/sh
set -eu

MULTIPASS_DIR="/Library/Application Support/Golem Provider/multipass"
LOG_DIR="/Library/Logs/Golem Provider"
LOG_FILE="$LOG_DIR/installer-postinstall.log"
MIN_VERSION="1.13.0"
BLOCKED_APPLE_SILICON_VERSION="1.16.2+mac"
COMMAND_TIMEOUT_SECONDS=5
INSTALL_TIMEOUT_SECONDS=300
MULTIPASSD_LABEL="system/com.canonical.multipassd"
MULTIPASSD_PLIST="/Library/LaunchDaemons/com.canonical.multipassd.plist"
OFFICIAL_MULTIPASS_BIN="/Library/Application Support/com.canonical.multipass/bin/multipass"

if ! mkdir -p "$LOG_DIR" 2>/dev/null; then
  LOG_FILE="${TMPDIR:-/tmp}/golem-provider-installer-postinstall.log"
fi

log() {
  timestamp="$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || date)"
  printf "%s %s\n" "$timestamp" "$*" >&2
  { printf "%s %s\n" "$timestamp" "$*" >>"$LOG_FILE"; } 2>/dev/null || true
}

on_exit() {
  status="$?"
  if [ "$status" -eq 0 ]; then
    log "Golem Provider postinstall completed successfully"
  else
    log "Golem Provider postinstall failed with status $status"
  fi
}

trap on_exit EXIT

temp_file() {
  mktemp "${TMPDIR:-/tmp}/golem-provider-installer.XXXXXX"
}

log_file_contents() {
  output_file="$1"
  if [ -s "$output_file" ]; then
    while IFS= read -r output_line; do
      log "  $output_line"
    done <"$output_file"
  fi
}

run_capture_to_file() {
  timeout_seconds="$1"
  output_file="$2"
  log_output="$3"
  shift 3

  : >"$output_file"
  log "Running command with ${timeout_seconds}s timeout: $*"
  "$@" >"$output_file" 2>&1 &
  command_pid="$!"
  elapsed_seconds=0

  while kill -0 "$command_pid" 2>/dev/null; do
    if [ "$elapsed_seconds" -ge "$timeout_seconds" ]; then
      log "Command timed out after ${timeout_seconds}s: $*"
      kill "$command_pid" 2>/dev/null || true
      sleep 1
      kill -9 "$command_pid" 2>/dev/null || true
      wait "$command_pid" 2>/dev/null || true
      if [ "$log_output" = "1" ]; then
        log_file_contents "$output_file"
      fi
      return 124
    fi
    sleep 1
    elapsed_seconds=$((elapsed_seconds + 1))
  done

  if wait "$command_pid"; then
    command_status=0
  else
    command_status="$?"
  fi
  log "Command exited ${command_status}: $*"
  if [ "$log_output" = "1" ]; then
    log_file_contents "$output_file"
  fi
  return "$command_status"
}

run_logged() {
  timeout_seconds="$1"
  shift
  output_file="$(temp_file)"
  run_capture_to_file "$timeout_seconds" "$output_file" 1 "$@"
  command_status="$?"
  rm -f "$output_file"
  return "$command_status"
}

run_status_only() {
  timeout_seconds="$1"
  shift
  output_file="$(temp_file)"
  run_capture_to_file "$timeout_seconds" "$output_file" 0 "$@"
  command_status="$?"
  rm -f "$output_file"
  return "$command_status"
}

version_core() {
  printf "%s" "$1" | sed 's/[+-].*$//'
}

version_lt() {
  awk -v a="$(version_core "$1")" -v b="$(version_core "$2")" 'BEGIN {
    split(a, av, "."); split(b, bv, ".");
    for (i = 1; i <= 3; i++) {
      ai = av[i] + 0; bi = bv[i] + 0;
      if (ai < bi) exit 0;
      if (ai > bi) exit 1;
    }
    exit 1;
  }'
}

multipass_path() {
  for candidate in "$OFFICIAL_MULTIPASS_BIN" /usr/local/bin/multipass /opt/homebrew/bin/multipass /opt/local/bin/multipass; do
    if [ -x "$candidate" ]; then
      log "Found Multipass binary: $candidate"
      printf "%s" "$candidate"
      return 0
    fi
  done
  if command -v multipass >/dev/null 2>&1; then
    log "Found Multipass on PATH: $(command -v multipass)"
    command -v multipass
    return 0
  fi
  log "No Multipass binary found"
  return 1
}

read_multipass_version() {
  mp="$1"
  output_file="$(temp_file)"
  if ! run_capture_to_file "$COMMAND_TIMEOUT_SECONDS" "$output_file" 1 "$mp" version; then
    rm -f "$output_file"
    return 1
  fi
  version="$(sed -n 's/.*multipass[[:space:]][[:space:]]*\([0-9][^[:space:]]*\).*/\1/p' "$output_file" | head -n 1)"
  rm -f "$output_file"
  if [ -z "$version" ]; then
    log "Unable to parse Multipass version"
    return 1
  fi
  log "Parsed Multipass version: $version"
  printf "%s" "$version"
}

multipass_supported() {
  mp="$(multipass_path)" || return 1
  version="$(read_multipass_version "$mp")"
  [ -n "$version" ] || return 1
  if version_lt "$version" "$MIN_VERSION"; then
    log "Multipass version $version is older than required $MIN_VERSION"
    return 1
  fi
  host_arch="$(uname -m 2>/dev/null || true)"
  if [ "$host_arch" = "arm64" ] && [ "$version" = "$BLOCKED_APPLE_SILICON_VERSION" ]; then
    log "Multipass version $version is blocked on Apple Silicon; installing bundled package"
    return 1
  fi
  return 0
}

verify_multipass() {
  verify_multipass_daemon || return 1
  multipass_supported
}

verify_multipass_daemon() {
  if run_status_only "$COMMAND_TIMEOUT_SECONDS" /bin/launchctl print "$MULTIPASSD_LABEL"; then
    log "Multipass daemon is registered with launchd"
    return 0
  fi

  if [ ! -f "$MULTIPASSD_PLIST" ]; then
    log "Multipass daemon plist is missing: $MULTIPASSD_PLIST"
    return 1
  fi

  log "Multipass daemon is not registered; attempting launchd bootstrap"
  run_logged "$COMMAND_TIMEOUT_SECONDS" /bin/launchctl bootstrap system "$MULTIPASSD_PLIST" || true
  run_logged "$COMMAND_TIMEOUT_SECONDS" /bin/launchctl kickstart -k "$MULTIPASSD_LABEL" || true

  if run_status_only "$COMMAND_TIMEOUT_SECONDS" /bin/launchctl print "$MULTIPASSD_LABEL"; then
    log "Multipass daemon is registered with launchd"
    return 0
  fi

  log "Multipass daemon is not registered with launchd"
  return 1
}

log_diagnostics() {
  log "Diagnostics begin"
  log "User: $(id 2>/dev/null || true)"
  log "PATH: ${PATH:-}"
  log "TMPDIR: ${TMPDIR:-}"
  log "Log file: $LOG_FILE"
  run_logged "$COMMAND_TIMEOUT_SECONDS" /bin/launchctl print system/com.canonical.multipassd || true
  if [ -f /Library/Logs/Multipass/multipassd.log ]; then
    log "Tail of /Library/Logs/Multipass/multipassd.log"
    tail -n 80 /Library/Logs/Multipass/multipassd.log 2>&1 | while IFS= read -r output_line; do
      log "  $output_line"
    done
  else
    log "Multipass daemon log not found"
  fi
  log "Diagnostics end"
}

log "Golem Provider postinstall started"
log "Log file: $LOG_FILE"

log "Verifying existing Multipass installation"
if verify_multipass; then
  log "Multipass verification succeeded"
  log "Compatible Multipass already installed"
  exit 0
fi

pkg="$(find "$MULTIPASS_DIR" -maxdepth 1 -name 'multipass-*.pkg' -print | head -n 1)"
if [ -z "$pkg" ] || [ ! -f "$pkg" ]; then
  log "Bundled Multipass pkg is missing from $MULTIPASS_DIR"
  log_diagnostics
  exit 1
fi

log "Installing bundled Multipass package: $pkg"
if ! run_logged "$INSTALL_TIMEOUT_SECONDS" /usr/sbin/installer -pkg "$pkg" -target /; then
  log "Bundled Multipass installer failed"
  log_diagnostics
  exit 1
fi

log "Verifying installed Multipass package"
if ! verify_multipass; then
  log "Multipass installed but verification failed"
  log_diagnostics
  exit 1
fi

log "Multipass verification succeeded"
log "Multipass installed and verified"
