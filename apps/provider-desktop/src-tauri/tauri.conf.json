{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Golem Provider",
  "version": "0.1.11",
  "identifier": "network.golem.provider",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Golem Provider",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/golem-provider"
    ]
  }
}
